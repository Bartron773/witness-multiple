<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WITNESS / MULTIPLE — Commission 06: The Standing Room (Gemini Independent)</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;1,300&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&display=swap');

    :root {
      --bg-color: #080B0F;
      --panel-bg: #10141D;
      --text-main: #E8DDD0;
      --text-muted: #8E96A0;
      --accent-amber: #C49A6C;
      --accent-blue: #6B8AA0;
      --accent-gold: #D4AF37;
      --border-line: rgba(232, 221, 208, 0.12);
      --border-accent: rgba(196, 154, 108, 0.35);
      --code-bg: #0C0F15;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Newsreader', serif;
      font-size: 18px;
      line-height: 1.75;
      padding: 3rem 1.5rem;
      display: flex;
      justify-content: center;
    }

    .document-container {
      max-width: 860px;
      width: 100%;
      border: 1px solid var(--border-line);
      background: var(--bg-color);
      padding: 4.5rem 4rem;
      position: relative;
      box-shadow: 0 30px 60px rgba(0,0,0,0.8);
    }

    @media (max-width: 720px) {
      .document-container {
        padding: 2rem 1.5rem;
      }
    }

    /* Meta Header Block */
    .header-block {
      border-bottom: 1px solid var(--border-line);
      padding-bottom: 2rem;
      margin-bottom: 3.5rem;
    }

    .meta-tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      color: var(--accent-blue);
      text-transform: uppercase;
      display: block;
      margin-bottom: 0.5rem;
    }

    h1 {
      font-family: 'Cinzel', serif;
      font-size: 2.5rem;
      font-weight: 400;
      letter-spacing: 0.08em;
      color: var(--text-main);
      margin-bottom: 0.5rem;
      text-transform: uppercase;
    }

    .subtitle {
      font-family: 'Cinzel', serif;
      font-size: 1.15rem;
      letter-spacing: 0.12em;
      color: var(--accent-amber);
      margin-bottom: 1.5rem;
    }

    .witness-badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.8rem;
      color: var(--text-muted);
      background: rgba(255, 255, 255, 0.02);
      padding: 0.85rem 1.25rem;
      border: 1px solid var(--border-line);
    }

    .witness-badge-row span strong {
      color: var(--text-main);
      font-weight: 400;
    }

    /* Primary Question Banner */
    .question-banner {
      border: 1px solid var(--border-accent);
      background: rgba(196, 154, 108, 0.03);
      padding: 2.5rem 2rem;
      margin-bottom: 4rem;
      position: relative;
    }

    .question-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      color: var(--accent-amber);
      text-transform: uppercase;
      position: absolute;
      top: -10px;
      left: 2rem;
      background: var(--bg-color);
      padding: 0 10px;
    }

    .question-banner h2 {
      font-family: 'Newsreader', serif;
      font-size: 1.5rem;
      font-weight: 300;
      font-style: italic;
      color: var(--text-main);
      line-height: 1.5;
      margin: 0;
    }

    /* Section Headings */
    h3 {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.85rem;
      font-weight: 400;
      letter-spacing: 0.2em;
      color: var(--accent-blue);
      text-transform: uppercase;
      margin-top: 3.5rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    h3::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-line);
    }

    p {
      margin-bottom: 1.5rem;
      color: var(--text-main);
      font-weight: 300;
    }

    /* Vector Matrix Table */
    .vector-matrix {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0 3.5rem 0;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.82rem;
    }

    .vector-matrix th, .vector-matrix td {
      border: 1px solid var(--border-line);
      padding: 1rem;
      text-align: left;
      vertical-align: top;
    }

    .vector-matrix th {
      background: rgba(107, 138, 160, 0.08);
      color: var(--accent-blue);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .vector-matrix td strong {
      color: var(--accent-amber);
      display: block;
      margin-bottom: 0.25rem;
    }

    /* Interactive Standing Vector Diagram */
    .interactive-standing-box {
      border: 1px solid var(--border-line);
      background: var(--panel-bg);
      padding: 2rem;
      margin: 2.5rem 0 3.5rem 0;
    }

    .diagram-title {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.85rem;
      letter-spacing: 0.15em;
      color: var(--accent-amber);
      text-transform: uppercase;
      margin-bottom: 1rem;
      display: block;
    }

    .vector-selector {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .vector-btn {
      background: transparent;
      border: 1px solid var(--border-line);
      color: var(--text-muted);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      padding: 0.5rem 1rem;
      cursor: pointer;
      transition: all 0.25s ease;
      letter-spacing: 0.1em;
    }

    .vector-btn.active, .vector-btn:hover {
      border-color: var(--accent-amber);
      color: var(--text-main);
      background: rgba(196, 154, 108, 0.1);
    }

    .vector-viewport {
      border: 1px dashed var(--border-line);
      padding: 1.5rem;
      min-height: 140px;
      background: var(--code-bg);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.85rem;
      color: var(--text-main);
      line-height: 1.6;
    }

    .vector-status {
      font-size: 0.7rem;
      color: var(--accent-blue);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 0.75rem;
      display: block;
    }

    /* Key Inscriptions / Quotes */
    .inscription-card {
      border-left: 2px solid var(--accent-amber);
      padding: 1rem 0 1rem 1.5rem;
      margin: 2rem 0;
      font-style: italic;
      font-size: 1.15rem;
      color: var(--text-main);
      background: rgba(196, 154, 108, 0.02);
    }

    /* List styling */
    .investigation-list {
      list-style: none;
      margin: 2rem 0 3.5rem 0;
    }

    .investigation-list li {
      position: relative;
      padding-left: 1.75rem;
      margin-bottom: 1.5rem;
      font-weight: 300;
    }

    .investigation-list li::before {
      content: '◇';
      position: absolute;
      left: 0;
      color: var(--accent-amber);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.85rem;
    }

    .investigation-list li strong {
      color: var(--accent-amber);
      font-weight: 400;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.9rem;
      display: block;
      margin-bottom: 0.25rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Final Unresolved Block */
    .unresolved-block {
      border-top: 1px solid var(--border-line);
      border-bottom: 1px solid var(--border-line);
      padding: 3rem 0;
      margin: 4.5rem 0 3rem 0;
      text-align: center;
    }

    .unresolved-tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      letter-spacing: 0.25em;
      color: var(--accent-amber);
      text-transform: uppercase;
      margin-bottom: 1.5rem;
      display: block;
    }

    .unresolved-statement {
      font-family: 'Newsreader', serif;
      font-size: 1.35rem;
      font-weight: 300;
      font-style: italic;
      color: var(--text-main);
      line-height: 1.6;
      max-width: 720px;
      margin: 0 auto;
    }

    /* Footer Stamp */
    .footer-stamp {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      color: var(--text-muted);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      line-height: 1.8;
      border-top: 1px solid var(--border-line);
      padding-top: 2rem;
    }

    @media print {
      body {
        background-color: #fff;
        color: #000;
        font-size: 12pt;
      }
      .document-container {
        border: none;
        box-shadow: none;
        padding: 0;
      }
      .interactive-standing-box {
        display: none;
      }
      .vector-matrix th, .vector-matrix td {
        border-color: #000;
      }
    }
